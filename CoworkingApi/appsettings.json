{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=coworking_db;User=root;Password=<DATABASE_PASSWORD>;"
  },
  "JwtSettings": {
    "SecretKey": "<JWT_SECRET_KEY_MIN_32_CHARS>",
    "Issuer": "CoworkingApi",
    "Audience": "CoworkingClient",
    "ExpiresInMinutes": 1440
  },
  "Encryption": {
    "Key": "<ENCRYPTION_KEY>"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "post:/api/auth/login",
        "Period": "5m",
        "Limit": 10
      },
      {
        "Endpoint": "post:/api/auth/register",
        "Period": "10m",
        "Limit": 5
      },
      {
        "Endpoint": "post:/api/bookings",
        "Period": "1m",
        "Limit": 5
      }
    ]
  },
  "IpRateLimitPolicies": {
    "IpRules": []
  }
}